            },
            "torso": {
              "type": "boolean"
            },
            "larm": {
              "type": "boolean"
            },
            "rarm": {
              "type": "boolean"
            },
            "lleg": {
              "type": "boolean"
            },
            "rleg": {
              "type": "boolean"
            }
          }
