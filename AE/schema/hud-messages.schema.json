    },
    "effects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/effect"
      }
    },
    "effectRemove": {
      "$ref": "#/$defs/id"
    },
    "announce": {
      "type": "boolean"
    },
    "heading": {
      "type": "number"
    },
    "markers": {
      "type": "array",
      "items": {
