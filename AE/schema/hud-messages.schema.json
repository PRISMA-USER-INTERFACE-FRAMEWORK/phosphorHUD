      }
    },
    "marker": {
      "$ref": "#/$defs/marker"
    },
    "markerRemove": {
      "$ref": "#/$defs/id"
    },
    "tracker": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
