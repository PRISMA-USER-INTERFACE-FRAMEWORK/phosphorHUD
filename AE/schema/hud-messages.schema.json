        "torso": {
          "$ref": "#/$defs/fraction"
        },
        "larm": {
          "$ref": "#/$defs/fraction"
        },
        "rarm": {
          "$ref": "#/$defs/fraction"
        },
        "lleg": {
          "$ref": "#/$defs/fraction"
        },
        "rleg": {
          "$ref": "#/$defs/fraction"
        }
      }
    },
    "figure": {
      "type": "object",
      "additionalProperties": false,
