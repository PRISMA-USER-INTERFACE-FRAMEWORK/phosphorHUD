          "enum": [
            "fatigue",
            "infection",
            "insomnia",
            "lethargy",
            "parasites",
            "weakness"
          ]
        }
      ]
    },
    "weapon": {
      "type": "string"
    },
    "clip": {
      "type": "integer",
      "minimum": 0
    },
    "clipMax": {
      "type": "integer",
      "minimum": 0
    },
    "reserve": {
      "type": "integer",
      "minimum": 0
    },
    "weaponLegendary": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 5
    },
    "flashlight": {
      "type": "boolean"
    },
    "explosive": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "short": {
              "type": "string",
              "maxLength": 6
            },
            "count": {
              "type": "integer",
              "minimum": 0
            },
            "announce": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "grenades": {
      "type": "integer",
      "minimum": 0
